{
	"$schema": "wtq.schema.json",
	"Apps": [
		{
			"Name": "Wezterm",
			"Hotkeys": [
				{
					"Modifiers": "Alt",
					"KeyChar": "z"
				}
			],
			"FileName": "wezterm-gui",
			"ArgumentList": [
				{ "Argument": "start" },
				{ "Argument": "--class" },
				{ "Argument": "wtq" }
			],
			"MainWindow": "Either",
			"Opacity": 100,
			"Resize": "Always",
			"HorizontalScreenCoverage": 101,
			"HorizontalAlign": "Center",
			"VerticalScreenCoverage": 42,
			"VerticalOffset": 0,
			"AnimationTypeToggleOn": "EaseOutQuart"
		}
	],
	"ShowUiOnStart": true,
	"AlwaysOnTop": true,
	"AnimationTypeToggleOff": "EaseInQuart"
}
